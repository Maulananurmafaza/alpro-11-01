ALGORITMA NilaiUjian

DEKLARASI
    CONST NMAX = 1001
    TYPE tabNilai : array[0..NMAX-1] of integer

    T : tabNilai
    n : integer

PROCEDURE inputData(T, n)
    DEKLARASI
        nilai : integer
        i : integer

    ALGORITMA
        n ← 0

        FOR i ← 0 TO NMAX-1 DO
            input(nilai)

            IF nilai < 0 THEN
                RETURN
            ENDIF

            T[n] ← nilai
            n ← n + 1
        ENDFOR

ENDPROCEDURE

ALGORITMA UTAMA
    inputData(T, n)

SELESAI